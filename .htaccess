# ASCENTRA - dominio canónico (SEO): siempre https://ascentramx.com
<IfModule mod_rewrite.c>
  RewriteEngine On
  # www y/o HTTP → https://ascentramx.com (un solo 301, sin doble redirección)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://ascentramx.com%{REQUEST_URI} [L,R=301]
</IfModule>

# ASCENTRA - control de caché para evitar versiones viejas en móvil (Safari/iOS)

<IfModule mod_headers.c>
  # HTML: siempre pedir la versión más reciente
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # JS, CSS y JSON: pueden guardarse, pero deben revalidar con el servidor
  <FilesMatch "\.(js|css|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Imágenes: caché larga (cambian poco)
  <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
</IfModule>

# MIME type correcto para el catálogo JSON
AddType application/json .json
